[Unit]
Description=Custom App on TTY2
After=systemd-user-sessions.service
Conflicts=getty@tty2.service

[Service]
Type=simple
ExecStart=/home/ethan/Projects/fb-dm/image /home/ethan/Projects/fb-dm/lilyb/1.ppm /home/ethan/Projects/fb-dm/lilyb/2.ppm
StandardInput=tty-force
StandardOutput=inherit
StandardError=inherit
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
Restart=always

[Install]
WantedBy=multi-user.target